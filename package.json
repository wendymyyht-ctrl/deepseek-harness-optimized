{
  "name": "deepseek-harness-optimized",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A privacy-safe DeepSeek Harness profile with vision tools, indexed HTML, and automatic compact-and-continue.",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "profile"
  ],
  "scripts": {
    "build:macos": "node scripts/build-macos.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "vendor:install": "node scripts/install-vendor.mjs",
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "test": "node --test profile/tests/*.test.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "security-check": "node scripts/security-check.mjs",
    "verify": "node --test profile/tests/*.test.mjs && node scripts/security-check.mjs",
    "postinstall": "node scripts/patch-vision.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.1"
  },
  "devDependencies": {
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "packageManager": "pnpm@11.19.0"
}
